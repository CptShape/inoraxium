{
  "name": "inoraxium-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inoraxium evreninin salt okunur dijital atlası",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node _site/scripts/check-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test _site/tests/*.test.mjs",
    "audit:links": "node _site/scripts/audit.mjs",
    "vault:build": "node _site/scripts/audit.mjs",
    "firebase:sync": "node --env-file-if-exists=.env _site/scripts/sync-firebase.mjs",
    "test:rules": "firebase emulators:exec --project demo-inoraxium --only firestore \"node --test _site/tests/security.rules.mjs\"",
    "firebase:sync:login": "node --env-file-if-exists=.env _site/scripts/sync-with-login.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "dompurify": "^3.2.6",
    "firebase": "^13.3.0",
    "github-slugger": "^2.0.0",
    "lucide": "^0.468.0",
    "marked": "^16.0.0",
    "marked-footnote": "^1.4.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "jsdom": "^27.4.0",
    "sharp": "^0.35.5",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
