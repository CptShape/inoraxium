rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function dm() { return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.dm == true; }
    match /roles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if dm() || (signedIn() && request.auth.uid == uid);
      allow list: if dm();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200;
      allow delete: if false;
    }
    match /pages/{key} {
      allow read: if dm() || resource.data.visibility == 'public'
        || (signedIn() && resource.data.visibility == 'users' && request.auth.uid in resource.data.readerUids);
      allow update: if dm()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility', 'readerUids'])
        && request.resource.data.visibility in ['dm', 'public', 'users']
        && request.resource.data.readerUids is list
        && request.resource.data.readerUids.size() <= 100
        && (request.resource.data.visibility == 'users' || request.resource.data.readerUids.size() == 0);
      allow create, delete: if false;
    }
  }
}
