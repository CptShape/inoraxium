# Firebase Console -> Project settings -> Your apps -> Web app
# These VITE values are public web configuration, NOT admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Only for the local content upload command. NEVER use a VITE_ prefix here.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/inoraxium-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
